  "cards": [
    {
      "dot": "emerald",
      "title": "Onboarding Lifecycle",
      "items": [
        "Language selection sets app locale and phonetics layout prior to account creation",
        "Parent onboarding is strictly isolated from the child learning dashboard"
      ]
    },
    {
      "dot": "rose",
      "title": "Compliance & Safety",
      "items": [
        "Verified Parental Consent (VPC) is mandatory before storing any child credentials",
        "Sliding-window Redis rate limit blocks brute-force OTP attempts after 3 failures"
      ]
    },
    {
      "dot": "cyan",
      "title": "Session Authorization",
      "items": [
        "OTP verification yields an authenticated session token for the parent",
