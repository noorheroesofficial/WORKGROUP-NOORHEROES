    { "id": "pin_setup", "lane": "parent_surface", "col": 5, "type": "security", "label": "Parent PIN Setup", "sublabel": "4-digit server hashed", "tag": "authoritative", "width": 132 },
    { "id": "home", "lane": "child_surface", "col": 5, "type": "frontend", "label": "Child Home", "sublabel": "day / calm bedtime mode", "tag": "active session", "width": 132 }
