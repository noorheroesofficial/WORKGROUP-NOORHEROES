    { "id": "verify-to-pin", "from": "otp_verify", "to": "pin_setup", "label": "auth success", "variant": "security" },
    { "id": "pin-to-home", "from": "pin_setup", "to": "home", "label": "enter app", "variant": "emphasis" }
