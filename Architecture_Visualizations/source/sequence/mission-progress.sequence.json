{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Daily Learning Mission Progress Sequence",
    "output": "mission-progress.sequence.html",
    "viewBox": [1080, 540],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "client-request-and-cache",
        "label": "Client Ingress & Cache Check",
        "focus": ["mobile", "api", "redis"],
        "note": "Follow mobile request to FastAPI and evaluate the Redis cache-miss check."
      },
      {
        "id": "db-query-and-cache-fill",
        "label": "PostgreSQL Query & Cache Fill",
        "focus": ["api", "db", "redis"],
        "note": "Inspect durable SQL query for child mission state and subsequent Redis cache population."
      },
      {
        "id": "response-and-offline-sync",
        "label": "Response & Local Sync",
        "focus": ["api", "mobile", "local_db"],
        "note": "Deliver verified mission JSON to mobile client for SQLDelight offline synchronization."
      }
    ]
  },
  "participants": [
    { "id": "mobile", "type": "frontend", "label": "NoorHeroes App", "sublabel": "KMP / Compose UI" },
    { "id": "local_db", "type": "database", "label": "SQLDelight", "sublabel": "Offline SQLite" },
    { "id": "api", "type": "backend", "label": "FastAPI Core", "sublabel": "/v1/learning" },
    { "id": "redis", "type": "database", "label": "Redis 7", "sublabel": "Cache :6379" },
    { "id": "db", "type": "database", "label": "PostgreSQL 16", "sublabel": "Rewards Ledger" }
  ],
  "segments": [
    { "from": 150, "to": 250, "label": "Request & Cache Lookup" },
    { "from": 260, "to": 385, "label": "Database Read & Cache Population" },
    { "from": 395, "to": 490, "label": "Delivery & Offline Persistence" }
  ],
  "messages": [
    { "id": "open-mission", "from": "mobile", "to": "api", "y": 160, "label": "GET /v1/learning/missions/today", "variant": "emphasis" },
    { "id": "cache-lookup", "from": "api", "to": "redis", "y": 195, "label": "GET mission:child:1042", "variant": "default" },
    { "id": "cache-miss", "from": "redis", "to": "api", "y": 228, "label": "cache miss (nil)", "variant": "return" },
    { "id": "sql-query", "from": "api", "to": "db", "y": 272, "label": "SELECT daily curriculum & stars", "variant": "emphasis" },
    { "id": "sql-rows", "from": "db", "to": "api", "y": 305, "label": "rows: 3 missions, 45 stars", "variant": "return" },
    { "id": "cache-write", "from": "api", "to": "redis", "y": 340, "label": "SETEX mission:child:1042 300s", "variant": "dashed" },
    { "id": "cache-ack", "from": "redis", "to": "api", "y": 372, "label": "OK", "variant": "return" },
    { "id": "client-reply", "from": "api", "to": "mobile", "y": 415, "label": "200 OK (JSON mission payload)", "variant": "return" },
    { "id": "local-sync", "from": "mobile", "to": "local_db", "y": 455, "label": "persist mission records", "variant": "dashed" }
  ],
  "activations": [
    { "participant": "mobile", "from": 160, "to": 465, "type": "frontend" },
    { "participant": "api", "from": 160, "to": 420, "type": "backend" },
    { "participant": "redis", "from": 195, "to": 232, "type": "database" },
    { "participant": "db", "from": 272, "to": 308, "type": "database" },
    { "participant": "redis", "from": 340, "to": 375, "type": "database" },
    { "participant": "local_db", "from": 455, "to": 475, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Request Sequence",
      "items": [
        "Mobile client initiates authenticated GET request for today's pedagogical missions",
        "FastAPI enforces token validation and queries Redis read-through cache"
      ]
    },
    {
      "dot": "amber",
      "title": "Durable Read & Cache Fill",
      "items": [
        "On cache miss, async SQLAlchemy queries PostgreSQL for mission curriculum and stars ledger",
        "Results populate Redis cache with a 300-second TTL to reduce database pressure"
      ]
    },
    {
      "dot": "cyan",
      "title": "Offline-First Sync",
      "items": [
        "Client receives 200 OK and immediately persists mission state into SQLDelight",
        "Child can complete daily Tajweed and phonetics missions even if connectivity drops"
      ]
    }
  ]
}
