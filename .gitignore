# -----------------------------------------------------------------------------
*.candidate.html
*.visual-check.png
*.visual-check.json
*.visual-check.html
.archify-cache/

# -----------------------------------------------------------------------------
# Test Results, Coverage & Reports
# -----------------------------------------------------------------------------
coverage/
htmlcov/
.coverage
.coverage.*
.nyc_output/
playwright-report/
blob-report/
test-results/

# -----------------------------------------------------------------------------
# Environment Files, Secrets & Security (Never commit secrets)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env.secret
*.env.override
!.env.example
!.env.template
local.properties
*.pem
*.key
*.cert
*.pfx
*.p12
*.jks
*.keystore
**/google-services-account*.json
**/*-service-account*.json
credentials.json

# -----------------------------------------------------------------------------
# Logs & Runtime Dumps
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# IDEs, Text Editors & Local Configurations
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
*.swp
*.swo
*~
*.bak
*.tmp
*.code-workspace

# -----------------------------------------------------------------------------
# AI Assistant Local & Transient State
# -----------------------------------------------------------------------------
.antigravity/
.claude/
.cursor/
.windsurf/
.fleet/
.zed/

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.stackdump

